{
  "name": "tssr-neo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TSSR NEO - plateforme pedagogique de simulation systemes & reseaux, 100% navigateur",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/*",
    "core/*",
    "simulation/*",
    "nova",
    "knowledge",
    "modules/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tssr/web",
    "build": "npm run build -w @tssr/web",
    "preview": "npm run preview -w @tssr/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:budget": "node scripts/check-budgets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:arch && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.8.0",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.4"
  }
}
